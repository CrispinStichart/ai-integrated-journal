# Local-only, non-secret configuration. Copy to .env and adjust absolute paths.
APP_ENV=development
JOURNAL_DATABASE_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://journal:${JOURNAL_DATABASE_PASSWORD}@host.docker.internal:5432/journal
BLOB_DATA_DIR=/home/your-user/.local/share/ai-integrated-journal/blobs
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=info
AUTH_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
