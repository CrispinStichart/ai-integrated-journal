# Local-only, non-secret configuration. Copy to .env and adjust absolute paths.
APP_ENV=development
JOURNAL_DATABASE_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://journal:${JOURNAL_DATABASE_PASSWORD}@host.docker.internal:5432/journal
BLOB_DATA_DIR=/home/your-user/.local/share/ai-integrated-journal/blobs
# Optional encrypted restic backups. Set all three non-overlapping paths together.
# backup:init creates the owner-only password file; keep a separate recovery copy.
# BACKUP_REPOSITORY_DIR=/home/your-user/backups/ai-integrated-journal
# BACKUP_PASSWORD_FILE=/home/your-user/.config/ai-integrated-journal/backup.password
# BACKUP_STAGING_DIR=/home/your-user/.cache/ai-integrated-journal/backup-staging
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=info
AUTH_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
