{
  "name": "@journal/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/commands/migrate.ts",
    "seed": "tsx src/commands/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@journal/test-support": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.8",
    "tsx": "4.23.12"
  },
  "dependencies": {
    "@journal/contracts": "workspace:*",
    "@journal/domain": "workspace:*",
    "@journal/processors": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg-boss": "12.26.3",
    "pg": "8.23.0"
  }
}
