{
  "name": "ai-integrated-journal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "build": "corepack pnpm -r --workspace-concurrency=1 run build",
    "data:bootstrap": "node infrastructure/bootstrap-local-data.mjs",
    "db:migrate": "corepack pnpm --filter @journal/database migrate",
    "db:seed": "corepack pnpm --filter @journal/database seed",
    "dev": "corepack pnpm --parallel --filter './apps/**' run dev",
    "infra:down": "docker compose -f infrastructure/compose.yaml down",
    "infra:up": "docker compose -f infrastructure/compose.yaml up -d --wait",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "corepack pnpm --filter @journal/web build && playwright test",
    "test:infrastructure": "vitest run --config vitest.infrastructure.config.ts",
    "typecheck": "corepack pnpm -r --parallel run typecheck",
    "validate": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm boundaries && corepack pnpm typecheck && corepack pnpm test:coverage && corepack pnpm build && corepack pnpm test:e2e"
  },
  "simple-git-hooks": {
    "pre-commit": "corepack pnpm validate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1"
  }
}
